import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { DOCS_NAV } from "../consts";

interface Props {
  title?: string;
  description?: string;
  /** Set when the page is Markdown (`layout:` in its frontmatter). */
  frontmatter?: { title: string; description?: string };
}
// .astro pages pass title/description as props; Markdown pages pass them in `frontmatter`.
const { title, description } = Astro.props.frontmatter ?? Astro.props;
// Normalize trailing slashes so "/docs/" and "/docs" both match.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

// Previous/next page, in left-nav order.
const flat = DOCS_NAV.flatMap((g) => g.items);
const at = flat.findIndex((it) => it.href === path);
const prev = at > 0 ? flat[at - 1] : undefined;
const next = at >= 0 && at < flat.length - 1 ? flat[at + 1] : undefined;
---

<Base title={`${title} — Light WAF docs`} description={description}>
  <Nav />
  <div class="wrap docs">
    <aside class="docs-side">
      {
        DOCS_NAV.map((g) => (
          <nav class="dg">
            <span class="dg-label">{g.group}</span>
            {g.items.map((it) => (
              <a href={it.href} class={path === it.href ? "active" : ""}>
                {it.label}
              </a>
            ))}
          </nav>
        ))
      }
    </aside>
    <main class="docs-main">
      <article class="prose">
        <slot />
        {
          (prev || next) && (
            <div class="doc-next">
              {prev && <a class="btn btn-ghost" href={prev.href}>← {prev.label}</a>}
              {next && <a class="btn btn-ghost" href={next.href}>{next.label} →</a>}
            </div>
          )
        }
      </article>
    </main>
  </div>
  <Footer />
</Base>
