---
// SPDX-FileCopyrightText: 2026 0x00spor3
// SPDX-License-Identifier: BUSL-1.1
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { CORE_REPO, CONTACT_MAILTO } from "../consts";

// The capability map — grounded in BOUNDARY.md. Honest about where the open core ends.
const map = [
  { area: "Detection & inspection", open: "Every module — SQLi, XSS, RCE, SSRF, … — plus gRPC & GraphQL inspection and the CRS engine.", ent: "Curated premium rules, managed schema-enforcement, premium native & bot-detection modules." },
  { area: "Rate limiting & state", open: "Single-node L7 token bucket (the StateStore trait + in-memory impl).", ent: "One budget shared across the fleet via Redis, plus IP reputation." },
  { area: "TLS", open: "Termination from file (rustls, HTTP/1.1 + HTTP/2 via ALPN).", ent: "ACME issuance & hitless rotation, mTLS with managed PKI, multi-node certs." },
  { area: "Rules", open: "seclang / ModSecurity parser + evaluation engine.", ent: "Curated premium content, and governed publish / rollback with a per-node agent." },
  { area: "Observability", open: "Prometheus /metrics + a structured JSON decision log.", ent: "Dashboards, long-term retention, blocked-request drill-down, alerting." },
  { area: "Access control", open: "A single static bearer token.", ent: "RBAC, SSO (OIDC), server-side sessions, revocable service tokens." },
  { area: "Audit & compliance", open: "—", ent: "A signed, hash-chained audit log and on-demand SOC2 / PCI evidence bundles." },
  { area: "SIEM", open: "Raw logs (your own shipper).", ent: "A push forwarder — normalized, at-least-once, with visible lag." },
  { area: "WASM plugins", open: "The runtime (Proxy-Wasm on wasmi).", ent: "Signature verification & marketplace." },
];

const guarantees = [
  { t: "Zero-datapath control plane", d: "The control plane reads telemetry off to the side. It never sits between clients and your backend — it cannot add latency or fail a request." },
  { t: "Zero-fork", d: "The enterprise builds against the published open core, unmodified, by version. An empty builder equals the plain proxy." },
  { t: "No retroactive take-backs", d: "A capability shipped in the open core can never be moved to the paid tier later. The only permitted move is enterprise → open." },
  { t: "Frozen public ABI", d: "The extension traits are SemVer-frozen and evolve only additively (new defaulted methods), so external implementations never break." },
  { t: "Pure-Rust, no C", d: "One memory-safe foundation across both tiers — no C libraries dragged into a security trust boundary." },
  { t: "Self-hosted", d: "Everything runs on your infrastructure. Nothing phones home; your traffic and your telemetry stay with you." },
];
---

<Base
  title="Where the line is — Light WAF open core vs enterprise"
  description="An honest map of what's in the open core (Apache-2.0) versus the commercial enterprise tier (BSL 1.1), and the rules that hold the boundary: zero-datapath, zero-fork, and no retroactive take-backs."
>
  <Nav />

  <!-- Hero -->
  <header class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Open core ↔ Enterprise</span>
        <h1>Where the <span class="accent">line</span> is.</h1>
        <p class="lede">
          An open-core product raises a fair question: what's free, what's paid, and is the open part
          real? Here's the honest map — and the rules that keep the line from moving.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={CORE_REPO}>Start with the open core</a>
          <a class="btn btn-ghost" href="#map">See the map</a>
        </div>
      </div>

      <div class="callout reveal">
        <p><b>The core is the security datapath.</b> It must be fully useful on a single node, and it must be inspectable — in security, trust requires open code.</p>
        <p><b>The enterprise sells scale, governance, and team operability</b> — never baseline detection.</p>
        <p class="mnemonic">
          <b>Understanding and inspecting</b> a protocol is core. <b>Managing it at scale, with governance</b>, is enterprise.
        </p>
      </div>
    </div>
  </header>

  <!-- Two promises -->
  <section id="promises">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Two promises</span>
        <h2>A complete core, extended by injection.</h2>
      </div>
      <div class="two-col">
        <div class="panel-block">
          <h3>The open core is complete — not a teaser</h3>
          <p>Every detection module is open, <em>including</em> gRPC and GraphQL inspection — precisely so the core is never a gutted demo. A single node runs standalone: proxy, phased pipeline, normalization, anomaly scoring, TLS from file, single-node rate limiting, config and hot reload.</p>
        </div>
        <div class="panel-block">
          <h3>The enterprise is additive, by injection</h3>
          <p>Every paid capability plugs into a public trait through the embedding builder. The open core is used unmodified, as a published crate — no fork, no patched core. Turn every enterprise seam off and you have exactly the open proxy.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Capability map -->
  <section id="map">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">The capability map</span>
        <h2>What's open, what's added.</h2>
        <p>Read it as: the open core gives you the whole datapath; the enterprise adds scale, governance and evidence around it.</p>
      </div>
      <div class="map">
        <table>
          <thead>
            <tr>
              <th>Area</th>
              <th>Open core · Apache-2.0</th>
              <th class="col-ent">Enterprise adds · BSL 1.1</th>
            </tr>
          </thead>
          <tbody>
            {map.map((r) => (
              <tr>
                <td class="area">{r.area}</td>
                <td class="open">{r.open}</td>
                <td class="ent">{r.ent}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- The seams -->
  <section id="seams">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">The seams</span>
        <h2>The enterprise uses public doors — the same ones you can.</h2>
        <p>For every enterprise feature, the core defines a public trait; the enterprise provides an at-scale implementation and injects it through the builder. Nothing is patched into the core.</p>
      </div>
      <pre class="code"><span class="c">// build against the published core as a library — no fork</span>
<span class="p">let</span> proxy = Proxy::builder(&amp;config)
    .state_store(Arc::new(RedisStore::connect(&amp;url)?))     <span class="c">// impl of a public trait</span>
    .cert_source(Arc::new(AcmeCertSource::new(..)))        <span class="c">// impl of a public trait</span>
    .module_factory(move || Ok(build_premium_modules()))  <span class="c">// extra modules, survive reload</span>
    .build().await?;

<span class="c">// every seam has a default → an empty builder equals the plain proxy.</span></pre>
      <p class="muted" style="margin-top:1rem;max-width:70ch">
        <span class="mono">StateStore</span>, <span class="mono">TlsCertSource</span> and <span class="mono">WafModule</span> are public, SemVer-frozen traits. The enterprise implements them — and so can you.
      </p>
    </div>
  </section>

  <!-- Guarantees -->
  <section id="rules">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">The rules that hold the line</span>
        <h2>Guarantees, not vibes.</h2>
        <p>The boundary is a written, normative policy — these are the parts that protect you.</p>
      </div>
      <div class="feature-grid">
        {guarantees.map((g) => (
          <div class="feature">
            <h3>{g.t}</h3>
            <p>{g.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Licensing -->
  <section id="licensing">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Licensing</span>
        <h2>Two licenses, one intent.</h2>
      </div>
      <div class="compare">
        <div class="edition">
          <span class="tag">Apache-2.0</span>
          <h3>The core</h3>
          <p>Permissive, with an explicit patent grant.</p>
          <ul>
            <li>Deliberately not AGPL/SSPL — the datapath stays widely adoptable</li>
            <li>Cloud-service restrictions live only in the enterprise tier</li>
            <li>Open code, so the security datapath is inspectable</li>
          </ul>
        </div>
        <div class="edition ent">
          <span class="tag">BSL 1.1</span>
          <h3>The enterprise</h3>
          <p>Source-available to customers; commercial.</p>
          <ul>
            <li>Scale, governance and operability — the moat, not the datapath</li>
            <li>Full source for customers to read and self-host</li>
            <li>Trademark: fork the code, but you can't call it Light WAF</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="wrap">
      <h2>Start open. Grow into the tier when you need it.</h2>
      <p>Run the open core today; add scale and governance when a fleet and an audit ask for it.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={CORE_REPO}>Explore the open core</a>
        <a class="btn btn-ghost" href={CONTACT_MAILTO}>Request enterprise access</a>
      </div>
    </div>
  </section>

  <Footer />
</Base>
